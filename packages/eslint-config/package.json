{
  "name": "@branchleft/eslint-config",
  "version": "0.8.3",
  "description": "Composable ESLint flat-config presets for branchLeft repos.",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "prepublishOnly": "pnpm build"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/branchLeft/standards.git",
    "directory": "packages/eslint-config"
  },
  "publishConfig": {
    "registry": "https://npm.pkg.github.com"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "dependencies": {
    "@eslint/js": "^10.0.1",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-jsdoc": "65.1.0",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-react-hooks": "^7.0.0",
    "eslint-plugin-unicorn": "76.0.0",
    "globals": "^17.13.0",
    "typescript-eslint": "^8.71.0"
  },
  "peerDependencies": {
    "eslint": "^9.0.0 || ^10.0.0",
    "eslint-plugin-sonarjs": "4.2.2"
  },
  "devDependencies": {
    "@branchleft/tsconfig": "workspace:*",
    "eslint-plugin-sonarjs": "4.2.2"
  }
}
