{
  "name": "@branchleft/vitest-config",
  "version": "0.4.0",
  "description": "Vitest defaults for branchLeft repos. Sets coverage.include so coverage is measurable at all, which the standards coverage clauses depend on.",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "prepublishOnly": "pnpm build"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/branchLeft/standards.git",
    "directory": "packages/vitest-config"
  },
  "publishConfig": {
    "registry": "https://npm.pkg.github.com"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "peerDependencies": {
    "@vitest/coverage-v8": "^3.0.0 || ^4.0.0",
    "vitest": "^3.0.0 || ^4.0.0"
  },
  "devDependencies": {
    "@branchleft/tsconfig": "workspace:*"
  }
}
