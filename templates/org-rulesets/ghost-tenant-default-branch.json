{
  "name": "Protect ghost-tenant-* default branches",
  "target": "branch",
  "enforcement": "active",
  "conditions": {
    "repository_name": {
      "include": ["ghost-tenant-*"],
      "exclude": ["*-archive"],
      "protected": false
    },
    "ref_name": {
      "include": ["~DEFAULT_BRANCH"],
      "exclude": []
    }
  },
  "rules": [
    { "type": "deletion" },
    { "type": "non_fast_forward" },
    { "type": "required_linear_history" },
    { "type": "required_signatures" },
    {
      "type": "pull_request",
      "parameters": {
        "required_approving_review_count": 1,
        "dismiss_stale_reviews_on_push": true,
        "required_reviewers": [],
        "require_code_owner_review": true,
        "require_last_push_approval": true,
        "required_review_thread_resolution": true,
        "allowed_merge_methods": ["squash"],
        "dismissal_restriction": { "enabled": false, "allowed_actors": [] }
      }
    },
    {
      "type": "required_status_checks",
      "parameters": {
        "strict_required_status_checks_policy": true,
        "do_not_enforce_on_create": false,
        "required_status_checks": [
          { "context": "Type check" },
          { "context": "Committed-secret guard" },
          { "context": "docs-lint / docs-lint" },
          { "context": "standards / Standards gates" }
        ]
      }
    }
  ],
  "bypass_actors": [{ "actor_type": "OrganizationAdmin", "bypass_mode": "pull_request" }]
}
