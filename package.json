{
  "name": "@branchleft/standards",
  "version": "0.1.0",
  "private": true,
  "description": "Engineering standards for branchLeft repos: prose, shared config, and CI gates.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/branchLeft/standards.git"
  },
  "packageManager": "pnpm@11.17.0",
  "prettier": "@branchleft/prettier-config",
  "scripts": {
    "typecheck": "tsc --noEmit",
    "format": "prettier --write . --ignore-path .gitignore --ignore-path .prettierignore --ignore-path packages/prettier-config/prettierignore",
    "format:check": "prettier --check . --ignore-path .gitignore --ignore-path .prettierignore --ignore-path packages/prettier-config/prettierignore",
    "selftest": "./tools/tests/run.sh",
    "prepare": "[ \"$CI\" = \"true\" ] || pre-commit install",
    "build": "pnpm -r --filter \"./packages/*\" run build",
    "lint": "eslint . --fix",
    "lint:check": "eslint .",
    "test:unit": "vitest --run",
    "test:coverage": "vitest --run --coverage",
    "audit:ts": "node tools/ts/bin/audit.ts"
  },
  "devDependencies": {
    "@branchleft/eslint-config": "workspace:*",
    "@branchleft/prettier-config": "workspace:*",
    "@branchleft/tsconfig": "workspace:*",
    "@branchleft/vitest-config": "workspace:*",
    "@types/node": "^26.0.0",
    "@vitest/coverage-v8": "^5.0.2",
    "eslint": "^10.11.0",
    "eslint-plugin-sonarjs": "4.2.1",
    "prettier": "^3.9.9",
    "typescript": "^7.0.2",
    "vitest": "^5.0.2"
  },
  "type": "module"
}
